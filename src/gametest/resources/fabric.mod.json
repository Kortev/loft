{
	"schemaVersion": 1,
	"id": "shootingstar-gametest",
	"version": "1.0.0",
	"name": "The Shooting Star test harness",
	"description": "Development only: game tests and client self tests for The Shooting Star and Chitty Chitty Bang Bang (Chitty and the Vulgarian airship), and game tests for the friends' mods (Gojolander).",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.kortev.shootingstar.test.WorldGenHelper",
			"io.github.kortev.shootingstar.test.MultiplayerTestServer",
			"io.github.kortev.shootingstar.test.DomainMultiplayerServer",
			"io.github.kortev.shootingstar.test.ChainsawMultiplayerServer",
			"io.github.kortev.shootingstar.test.CrashTestServer"
		],
		"fabric-gametest": [
			"io.github.kortev.shootingstar.test.DataGameTests",
			"io.github.kortev.shootingstar.test.StrikeGameTests",
			"io.github.kortev.shootingstar.test.GapGameTests",
			"io.github.kortev.shootingstar.test.ChittyGameTests",
			"io.github.kortev.shootingstar.test.ThunderGameTests",
			"io.github.kortev.shootingstar.test.AirshipGameTests",
			"io.github.kortev.shootingstar.test.DomainGameTests",
			"io.github.kortev.shootingstar.test.FormGameTests"
		],
		"client": [
			"io.github.kortev.shootingstar.test.ClientSelfTest",
			"io.github.kortev.shootingstar.test.GapSelfTest",
			"io.github.kortev.shootingstar.test.ChittySelfTest",
			"io.github.kortev.shootingstar.test.MjolnirSelfTest",
			"io.github.kortev.shootingstar.test.MultiplayerTestClient",
			"io.github.kortev.shootingstar.test.DomainMultiplayerClient",
			"io.github.kortev.shootingstar.test.ChainsawMultiplayerClient",
			"io.github.kortev.shootingstar.test.FilmSelfTest",
			"io.github.kortev.shootingstar.test.FilmDomain",
			"io.github.kortev.shootingstar.test.FilmDomainKortev",
			"io.github.kortev.shootingstar.test.DomainSelfTest",
			"io.github.kortev.shootingstar.test.FormSelfTest",
			"io.github.kortev.shootingstar.test.ReelSelfTest"
		]
	},
	"depends": {
		"shootingstar": "*",
		"chitty": "*",
		"gojolander": "*",
		"chainsawman": "*",
		"fabric-gametest-api-v1": "*"
	},
	"mixins": [
		"shootingstar-gametest.mixins.json"
	]
