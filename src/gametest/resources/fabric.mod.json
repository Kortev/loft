{
	"schemaVersion": 1,
	"id": "shootingstar-gametest",
	"version": "1.0.0",
	"name": "The Shooting Star test harness",
	"description": "Development only: game tests and a client self test for The Shooting Star.",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.kortev.shootingstar.test.WorldGenHelper",
			"io.github.kortev.shootingstar.test.MultiplayerTestServer",
			"io.github.kortev.shootingstar.test.CrashTestServer"
		],
		"fabric-gametest": [
			"io.github.kortev.shootingstar.test.StrikeGameTests",
			"io.github.kortev.shootingstar.test.GapGameTests"
		],
		"client": [
			"io.github.kortev.shootingstar.test.ClientSelfTest",
			"io.github.kortev.shootingstar.test.GapSelfTest",
			"io.github.kortev.shootingstar.test.MultiplayerTestClient"
		]
	},
	"depends": {
		"shootingstar": "*",
		"fabric-gametest-api-v1": "*"
	},
	"mixins": [
		"shootingstar-gametest.mixins.json"
	]
}
