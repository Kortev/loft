{
	"schemaVersion": 1,
	"id": "shootingstar-gametest",
	"version": "1.0.0",
	"name": "The Shooting Star test harness",
	"description": "Development only: game tests and client self tests for The Shooting Star and Chitty Chitty Bang Bang (Chitty and the Vulgarian airship).",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.kortev.shootingstar.test.WorldGenHelper",
			"io.github.kortev.shootingstar.test.MultiplayerTestServer",
			"io.github.kortev.shootingstar.test.CrashTestServer"
		],
		"fabric-gametest": [
			"io.github.kortev.shootingstar.test.DataGameTests",
			"io.github.kortev.shootingstar.test.StrikeGameTests",
			"io.github.kortev.shootingstar.test.GapGameTests",
			"io.github.kortev.shootingstar.test.ChittyGameTests",
			"io.github.kortev.shootingstar.test.ThunderGameTests",
			"io.github.kortev.shootingstar.test.AirshipGameTests"
		],
		"client": [
			"io.github.kortev.shootingstar.test.ClientSelfTest",
			"io.github.kortev.shootingstar.test.GapSelfTest",
			"io.github.kortev.shootingstar.test.ChittySelfTest",
			"io.github.kortev.shootingstar.test.MjolnirSelfTest",
			"io.github.kortev.shootingstar.test.MultiplayerTestClient",
			"io.github.kortev.shootingstar.test.FilmSelfTest"
		]
	},
	"depends": {
		"shootingstar": "*",
		"chitty": "*",
		"fabric-gametest-api-v1": "*"
	},
	"mixins": [
		"shootingstar-gametest.mixins.json"
	]
}
