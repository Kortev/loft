			"io.github.kortev.chainsawman.client.ChainsawManClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"mixins": [
		"chainsawman.mixins.json",
